# Database
DATABASE_URL=postgresql://localhost:5432/persona_model

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Telegram Bot
TELEGRAM_BOT_TOKEN=
